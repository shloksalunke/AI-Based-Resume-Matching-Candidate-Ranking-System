# Application Configuration
APP_NAME="Resume Matching API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api"

# Database Configuration (Defaults to local SQLite)
DATABASE_URL="sqlite:///./resume_matcher.db"

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Upload Settings
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# Optional LLM Configuration
USE_LLM=false
GEMINI_API_KEY=""
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CANDIDATES=15
LLM_MAX_CONCURRENCY=3

